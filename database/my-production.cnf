[mysqld]
# ============================================================
# MYSQL 8.0 PRODUCTION TUNING (8 vCPU / 8 GB RAM Allocation)
# Optimized for 2,000 Concurrent Assessment Users
# ============================================================

# --- Connection Limits ---
max_connections = 400
max_connect_errors = 10000
thread_cache_size = 64
innodb_thread_concurrency = 8

# --- Memory Allocation (2.5 GB Buffer Pool for 100% In-Memory DB) ---
innodb_buffer_pool_size = 2560M
innodb_buffer_pool_instances = 4
innodb_log_buffer_size = 64M
innodb_log_file_size = 256M

# --- High-Throughput Submission Tuning ---
# 2 = buffer logs in memory, flush every 1 second (10x faster concurrent submissions)
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# --- Query & Table Caches ---
table_open_cache = 2000
table_definition_cache = 1400
open_files_limit = 65535

# --- Timeouts ---
wait_timeout = 60
interactive_timeout = 60
connect_timeout = 10
